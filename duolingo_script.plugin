#!name=多邻国 Duolingo Super 脚本版 v6
#!desc=走脚本的版本：请求阶段读出原请求、自行重发，改写用户资料后把响应直接交回 App（对应 QX 的 script-analyze-echo-response），能处理 /batch 里以字符串嵌套的用户对象。不要与「多邻国 Duolingo Super v6」（复写版）同时启用，否则同一份响应会被改两遍。需开启脚本、重写与 MITM。
#!author=qinxi 原逻辑；Loon 适配
#!homepage=https://github.com/qinxi/script/blob/master/quantumult-x/rewrite/duolingo_app_rewrite.conf
#!loon_version=3.2.1(730)
#!tag=Duolingo

[Script]
# script-path 必须是 Loon 能下载到的地址（烤匠那种远程写法）。
# 本地文件名（如 duolingo_super.js）Loon 加载不到，脚本条目会显示空白、也不会执行 —— v2/v3/v5 都是这样失效的。
# 末尾否定预查排除脚本自己重放的请求（脚本内部还有一道同样的判断）。
http-request ^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/(?:batch|users/[0-9]+)/?(?:\?|$)(?!.*__loon_internal=1) script-path=https://raw.githubusercontent.com/shilianmalaxiangguo/loon-plugins/main/duolingo_super.js,requires-body=true,binary-body-mode=false,timeout=60,tag=Duolingo Super

[MITM]
hostname = *.duolingo.com, *.duolingo.cn
