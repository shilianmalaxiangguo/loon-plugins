#!name=多邻国 Duolingo Super v6
#!desc=纯 Loon 原生重写，不需要 JS：把用户资料里的订阅字段和「无限能量」开关 health.unlimitedHeartsAvailable 一起改掉（v4 少了后者，所以电池一直停在 20）。先停用旧版多邻国插件；需开启重写与 MITM。
#!author=qinxi 原订阅逻辑；Loon 适配
#!homepage=https://github.com/qinxi/script/blob/master/quantumult-x/rewrite/duolingo_app_rewrite.conf
#!loon_version=3.2.1(730)
#!tag=Duolingo

[Rewrite]
# 匹配「完整的用户资料」请求：/日期/users/数字ID?fields=…（该 fields 列表里含 health）。
# 为什么要带上 ?…health：同一路径还有只取局部字段的小请求，例如
#   /2023-05-23/users/<ID>?fields=streakData{…}          （不含 health，响应里没有订阅/健康字段）
# 只有完整资料那份响应里才有 health / subscriberLevel / subscriptionConfigs / shopItems；
# 只取局部字段的那份不加约束地改会莫名其妙多出 hasPlus、shopItems 之类的键。
#
# 为什么不是 /batch：batch 里的用户对象嵌在 responses[].body 字符串里，Key Path 动作够不到，
# 而且往 batch 顶层加键会破坏它的结构。本版 App（7.144.0）的用户资料是直连的，见 226 抓包。
#
# Key Path 动作是 Loon 原生的「复写 JSON 配置」语法：
#   response-body-json-replace <key path> <value> [<key path> <value> …]  key 必须已存在
#   response-body-json-add     <key path> <value> [<key path> <value> …]  key 不存在则新增，存在则覆盖
# 参数按空格分隔，所以 JSON 字面量一律写成紧凑形式（不带空格）。
# 按重要程度排：第一条就是电池 ♾️ 的开关，后面的都属于「订阅状态」外观。

# 1) 无限能量（电池 ♾️）+ 订阅等级 + 追踪标记 + 清空广告位
^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/users/[0-9]+\?.*health response-body-json-replace health.unlimitedHeartsAvailable true subscriberLevel GOLD trackingProperties.has_item_gold_subscription true adsConfig.units {}

# 2) 订阅配置：到期时间写死 2100-01-01（无脚本算不出「当前时间 + 400 天」，写死更耐久）
^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/users/[0-9]+\?.*health response-body-json-replace subscriptionConfigs [{"vendorPurchaseId":"loon_mock_purchase","isInBillingRetryPeriod":false,"isInGracePeriod":false,"pauseStart":null,"pauseEnd":null,"productId":"com.duolingo.DuolingoMobile.subscription.Gold.TwelveMonth.25Q3IncMS87D.Trial7.240","receiptSource":1,"expirationTimestamp":4102444800000,"isFreeTrialPeriod":false,"itemType":"gold_subscription"}]

# 3) hasPlus：免费用户资料里没有这个键，用 add
^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/users/[0-9]+\?.*health response-body-json-add hasPlus true

# 4) shopItems：免费用户是空数组，补一个 gold_subscription
^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/users/[0-9]+\?.*health response-body-json-add shopItems[0] {"purchaseId":"loon_mock_gold","purchaseDate":1792171699,"purchasePrice":0,"id":"gold_subscription","itemName":"gold_subscription","subscriptionInfo":{"currency":"USD","expectedExpiration":4102444800,"isFreeTrialPeriod":false,"isIntroOfferPeriod":false,"isInBillingRetryPeriod":false,"periodLength":12,"price":0,"productId":"com.duolingo.DuolingoMobile.subscription.Gold.TwelveMonth.25Q3IncMS87D.Trial7.240","renewer":"APPLE","renewing":false,"tier":"twelve_month","type":"gold","vendorPurchaseId":"loon_mock_vendor","promotionalOfferId":"","firstPaymentDate":0},"familyPlanInfo":{"ownerId":0,"secondaryMembers":[],"inviteTokens":[],"pendingInvites":[],"pendingInviteSuggestions":[]}}

# ---------------------------------------------------------------------------
# 可选（一般不用）：需要处理 /batch（用户对象嵌在 responses[].body 字符串里）时才用脚本版。
# 脚本必须按 Loon 的方式用远程地址引用，本地文件名不会加载 —— 那正是 Loon 里显示空白的原因（对照 kaojiang.Inplugin）：
#
# http-request ^https://(?:[A-Za-z0-9-]+\.)+duolingo\.(?:com|cn)/[0-9]{4}-[0-9]{2}-[0-9]{2}/(?:batch|users/[0-9]+)/?(?:\?|$)(?!.*__loon_internal=1) script-path=https://你的域名/duolingo_super.js,requires-body=true,binary-body-mode=false,timeout=60,tag=Duolingo Super
#
# 换成脚本版时：上面的 [Rewrite] 四行要注释掉（避免同一份响应被改两遍），并单独开一个 [Script] 段放这行。
# ---------------------------------------------------------------------------

[MITM]
hostname = *.duolingo.com, *.duolingo.cn
